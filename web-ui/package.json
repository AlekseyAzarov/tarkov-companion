{
  "name": "tarkov-companion-web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Web flow shown inside the Tarkov Companion SDK's WebView.",
  "type": "module",
  "scripts": {
    "generate-contract": "node ../scripts/generate-web-contract.mjs",
    "build": "node build.mjs",
    "dev": "node build.mjs --serve",
    "pretypecheck": "npm run generate-contract",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate-contract",
    "test": "vitest run"
  },
  "dependencies": {
    "preact": "10.29.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
