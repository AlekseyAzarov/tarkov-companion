# Generates contract_generated.h from contracts/; the Kotlin SDK generates its
# constants from the same files (buildSrc/GenerateContractSourcesTask.kt).

set(TARKOV_COMPANION_CONTRACTS_DIR ${CMAKE_CURRENT_LIST_DIR}/../../contracts)

# itemCacheCapacity -> ItemCacheCapacity, item_search -> ItemSearch
function(tarkov_companion_to_pascal_case name out_var)
  string(REPLACE "_" ";" parts "${name}")
  set(result "")
  foreach(part IN LISTS parts)
    string(SUBSTRING "${part}" 0 1 first)
    string(TOUPPER "${first}" first)
    string(SUBSTRING "${part}" 1 -1 rest)
    string(APPEND result "${first}${rest}")
  endforeach()
  set(${out_var} "${result}" PARENT_SCOPE)
endfunction()

# Appends `inline constexpr` for one JSON scalar at the given path to `out_var`.
function(tarkov_companion_append_constant out_var json constant_name)
  string(JSON type TYPE "${json}" ${ARGN})
  string(JSON value GET "${json}" ${ARGN})
  if(type STREQUAL "NUMBER")
    set(line "inline constexpr int64_t ${constant_name} = ${value};\n")
  elseif(type STREQUAL "STRING")
    set(line "inline constexpr const char* ${constant_name} = \"${value}\";\n")
  else()
    message(FATAL_ERROR "config-limits.json: ${constant_name} must be a number or a string")
  endif()
  set(${out_var} "${${out_var}}${line}" PARENT_SCOPE)
endfunction()

# Appends the strings of the JSON array at the given path to the list `out_var`.
function(tarkov_companion_append_string_array out_var json)
  set(result ${${out_var}})
  string(JSON count LENGTH "${json}" ${ARGN})
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON element GET "${json}" ${ARGN} ${index})
      list(APPEND result ${element})
    endforeach()
  endif()
  set(${out_var} ${result} PARENT_SCOPE)
endfunction()

# Appends `inline constexpr const char* <prefix><Name> = "<name>";` for each name.
function(tarkov_companion_append_name_constants out_var prefix)
  set(result "${${out_var}}")
  foreach(name IN LISTS ARGN)
    tarkov_companion_to_pascal_case(${name} name_pascal)
    string(APPEND result "inline constexpr const char* ${prefix}${name_pascal} = \"${name}\";\n")
  endforeach()
  set(${out_var} "${result}" PARENT_SCOPE)
endfunction()

function(tarkov_companion_generate_contract output)
  set(content "// Generated by core/cmake/contract.cmake from contracts/. Do not edit.\n")
  string(APPEND content "#pragma once\n\n#include <cstdint>\n\nnamespace tarkov_companion::contract {\n\n")

  file(GLOB query_files ${TARKOV_COMPANION_CONTRACTS_DIR}/queries/*.graphql)
  list(SORT query_files)
  foreach(query_file IN LISTS query_files)
    get_filename_component(stem ${query_file} NAME_WE)
    tarkov_companion_to_pascal_case(${stem} pascal)
    file(READ ${query_file} query)
    string(STRIP "${query}" query)
    string(APPEND content "inline constexpr const char* kQuery${pascal} = R\"graphql(${query})graphql\";\n\n")
  endforeach()

  set(limits_file ${TARKOV_COMPANION_CONTRACTS_DIR}/config-limits.json)
  file(READ ${limits_file} limits)
  foreach(section config profile bridgeOptions shared)
    tarkov_companion_to_pascal_case(${section} section_pascal)
    string(JSON key_count LENGTH "${limits}" ${section})
    math(EXPR last_key "${key_count} - 1")
    set(key_names "")
    foreach(key_index RANGE ${last_key})
      string(JSON key MEMBER "${limits}" ${section} ${key_index})
      tarkov_companion_to_pascal_case(${key} key_pascal)
      string(JSON key_type TYPE "${limits}" ${section} ${key})
      if(NOT key_type STREQUAL "OBJECT")
        tarkov_companion_append_constant(content "${limits}" k${key_pascal} ${section} ${key})
        continue()
      endif()
      string(APPEND content "inline constexpr const char* kKey${key_pascal} = \"${key}\";\n")
      list(APPEND key_names "\"${key}\"")
      string(JSON attribute_count LENGTH "${limits}" ${section} ${key})
      if(attribute_count GREATER 0)
        math(EXPR last_attribute "${attribute_count} - 1")
        foreach(attribute_index RANGE ${last_attribute})
          string(JSON attribute MEMBER "${limits}" ${section} ${key} ${attribute_index})
          tarkov_companion_to_pascal_case(${attribute} attribute_pascal)
          tarkov_companion_append_constant(content "${limits}" k${key_pascal}${attribute_pascal} ${section} ${key} ${attribute})
        endforeach()
      endif()
    endforeach()
    if(key_names)
      list(JOIN key_names ", " joined)
      string(APPEND content "inline constexpr const char* k${section_pascal}Keys[] = {${joined}};\n")
    endif()
    string(APPEND content "\n")
  endforeach()

  # Analytics events: names and property names, so neither can be misspelt.
  set(events_file ${TARKOV_COMPANION_CONTRACTS_DIR}/analytics-events.json)
  file(READ ${events_file} events)
  string(JSON web_prefix GET "${events}" webEventPrefix)
  string(APPEND content "inline constexpr const char* kWebEventPrefix = \"${web_prefix}\";\n")
  string(JSON event_count LENGTH "${events}" events)
  math(EXPR last_event "${event_count} - 1")
  set(property_names "")
  foreach(event_index RANGE ${last_event})
    string(JSON event MEMBER "${events}" events ${event_index})
    tarkov_companion_to_pascal_case(${event} event_pascal)
    string(APPEND content "inline constexpr const char* kEvent${event_pascal} = \"${event}\";\n")
    tarkov_companion_append_string_array(property_names "${events}" events ${event} properties)
  endforeach()
  list(REMOVE_DUPLICATES property_names)
  list(SORT property_names)
  tarkov_companion_append_name_constants(content kProperty ${property_names})
  string(APPEND content "\n")

  # Names contracts: any contracts/*.json with a `names` member, as
  # {"generate": {"cpp": ...}, "names": {"<Group>": [...]}}. Every group becomes
  # k<Group><Name> constants in contract::<generate.cpp>, or in contract itself
  # when that is empty.
  file(GLOB contract_files ${TARKOV_COMPANION_CONTRACTS_DIR}/*.json)
  list(SORT contract_files)
  set(names_files "")
  foreach(contract_file IN LISTS contract_files)
    file(READ ${contract_file} names_json)
    string(JSON group_count ERROR_VARIABLE not_a_names_contract LENGTH "${names_json}" names)
    if(NOT not_a_names_contract STREQUAL "NOTFOUND")
      continue()
    endif()

    list(APPEND names_files ${contract_file})
    string(JSON cpp_namespace ERROR_VARIABLE not_generated_for_cpp GET "${names_json}" generate cpp)
    if(NOT not_generated_for_cpp STREQUAL "NOTFOUND")
      continue()
    endif()

    get_filename_component(contract_file_name ${contract_file} NAME)
    string(APPEND content "// ${contract_file_name}\n")
    if(cpp_namespace)
      string(APPEND content "namespace ${cpp_namespace} {\n\n")
    endif()
    math(EXPR last_group "${group_count} - 1")
    foreach(group_index RANGE ${last_group})
      string(JSON group MEMBER "${names_json}" names ${group_index})
      set(group_names "")
      tarkov_companion_append_string_array(group_names "${names_json}" names ${group})
      tarkov_companion_append_name_constants(content k${group} ${group_names})
    endforeach()
    if(cpp_namespace)
      string(APPEND content "\n}  // namespace ${cpp_namespace}\n")
    endif()
    string(APPEND content "\n")
  endforeach()

  string(APPEND content "}  // namespace tarkov_companion::contract\n")

  # configure_file only touches the output when the content changed, so
  # regenerating does not rebuild the core needlessly.
  file(WRITE ${output}.in "${content}")
  configure_file(${output}.in ${output} COPYONLY)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
               ${query_files} ${limits_file} ${events_file} ${names_files})
endfunction()
